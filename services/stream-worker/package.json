{
  "name": "@glorycast/stream-worker",
  "version": "1.0.0",
  "description": "GloryCast Stream Worker — RTMP ingest, restream, WebRTC via LiveKit",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev":   "ts-node -r tsconfig-paths/register src/main.ts"
  },
  "dependencies": {
    "@nestjs/common":           "^10.4.0",
    "@nestjs/core":             "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/config":           "^3.3.0",
    "livekit-server-sdk":       "^2.5.0",
    "node-media-server":        "^2.7.0",
    "reflect-metadata":         "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript":  "^5.5.0",
    "ts-node":     "^10.9.0",
    "tsconfig-paths": "^4.2.0"
  }
}
