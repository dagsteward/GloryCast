# Baked into the renderer bundle by `npm run build` / `npm run build:renderer`
# (Vite defaults to production mode for `vite build`). This is what points a
# release installer at the real backend without anyone needing to remember to
# set VITE_API_URL by hand at release time — which is exactly the mistake
# that shipped the desktop app calling localhost:3001 on every customer's
# machine the first time around.
#
# Not secret: this is a public URL, the same one the app would show in its
# network requests regardless.
VITE_API_URL=https://glorycastbackend-production.up.railway.app
