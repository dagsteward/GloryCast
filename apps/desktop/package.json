{
  "name": "@glorycast/desktop",
  "version": "1.0.0",
  "description": "GloryCast AI Desktop Application",
  "author": "GloryCast",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "node scripts/electron-cjs.mjs && tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js && cross-env NODE_ENV=development electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "npm run build --workspace=@glorycast/licensing && tsc -p tsconfig.main.json && node scripts/electron-cjs.mjs",
    "build:renderer": "vite build",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "type-check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.0.7",
    "browserslist": "^4.28.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.363.0",
    "mdb-reader": "^2.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "socket.io-client": "^4.7.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.5.15",
    "vite": "^5.4.21",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "ai.glorycast.app",
    "productName": "GloryCast AI",
    "electronVersion": "29.4.6",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GloryCast"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
