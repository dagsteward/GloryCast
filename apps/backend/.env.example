# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://glorycast:glorycast_dev@localhost:5432/glorycast

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/v1/auth/microsoft/callback

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=glorycast
MINIO_SECRET_KEY=glorycast_secret
MINIO_BUCKET_MEDIA=glorycast-media
MINIO_BUCKET_RECORDINGS=glorycast-recordings
MINIO_PUBLIC_URL=http://localhost:9000

# ── AI Service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:3002
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# ── Stream Service ────────────────────────────────────────────────────────────
STREAM_SERVICE_URL=http://localhost:3003
RTMP_SERVER_URL=rtmp://localhost:1935
SRT_SERVER_URL=srt://localhost:4000

# ── LiveKit (WebRTC) ──────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Email (optional — use SMTP or skip for dev) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@glorycast.ai

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Misc ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
SWAGGER_ENABLED=true

# ── Licensing ─────────────────────────────────────────────────────────────────
# Ed25519 private key that signs desktop licences. Generate with:
#   node scripts/generate-license-keys.mjs
# Paste the whole PEM including BEGIN/END lines. NEVER commit the real value —
# anyone holding it can mint unlimited licences for your product.
LICENSE_PRIVATE_KEY=

# Paddle webhook signing secret (Paddle dashboard → Developer → Notifications).
# Without it, every payment webhook is rejected and no licence is ever issued.
PADDLE_WEBHOOK_SECRET=
