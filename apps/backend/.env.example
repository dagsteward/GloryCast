# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (docker compose).
DATABASE_URL=postgresql://glorycast:glorycast_dev@localhost:5432/glorycast
DIRECT_URL=postgresql://glorycast:glorycast_dev@localhost:5432/glorycast

# Supabase / production. TWO urls are required and they are NOT interchangeable.
#
# BOTH must use the POOLER host (aws-0-<region>.pooler.supabase.com). They
# differ only by port:
#
#   DATABASE_URL — port 6543, transaction mode. All runtime queries. Postgres
#                  allows only a few dozen direct connections and a container
#                  would exhaust them under load.
#   DIRECT_URL   — port 5432, SESSION mode. Migrations only. Transaction mode
#                  cannot run the session-level statements and advisory locks
#                  migrations need.
#
# Do NOT use db.<ref>.supabase.co:5432 for DIRECT_URL. That hostname is
# IPv6-only on current Supabase projects, and hosts without IPv6 egress
# (Railway among them) fail with "P1001: Can't reach database server". The
# session-mode pooler is the IPv4-reachable equivalent.
#
# Copy both from Supabase → Project Settings → Database → Connection string,
# rather than editing the templates below: the region and username format vary.
#
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/v1/auth/microsoft/callback

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=glorycast
MINIO_SECRET_KEY=glorycast_secret
MINIO_BUCKET_MEDIA=glorycast-media
MINIO_BUCKET_RECORDINGS=glorycast-recordings
MINIO_PUBLIC_URL=http://localhost:9000

# ── AI Service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:3002
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# ── Stream Service ────────────────────────────────────────────────────────────
STREAM_SERVICE_URL=http://localhost:3003
RTMP_SERVER_URL=rtmp://localhost:1935
SRT_SERVER_URL=srt://localhost:4000

# ── LiveKit (WebRTC) ──────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend (https://resend.com) delivers transactional email over HTTPS rather
# than SMTP — Railway and most PaaS egress treat SMTP ports inconsistently,
# while a plain HTTPS POST always works. Currently used for licence key
# delivery after a Paddle purchase.
#
# Without RESEND_API_KEY the app still runs: sends are logged instead of sent,
# so a mail outage never blocks the licence server that issues the key.
RESEND_API_KEY=
EMAIL_FROM=GloryCast <noreply@glorycast.ai>

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Misc ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
SWAGGER_ENABLED=true

# ── Licensing ─────────────────────────────────────────────────────────────────
# Ed25519 private key that signs desktop licences. Generate with:
#   node scripts/generate-license-keys.mjs
# Paste the whole PEM including BEGIN/END lines. NEVER commit the real value —
# anyone holding it can mint unlimited licences for your product.
LICENSE_PRIVATE_KEY=

# Paddle webhook signing secret (Paddle dashboard → Developer → Notifications).
# Without it, every payment webhook is rejected and no licence is ever issued.
PADDLE_WEBHOOK_SECRET=
