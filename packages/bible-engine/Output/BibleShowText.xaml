<UserControl x:Class="BibleShowText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Width="1920" Height="1080">
    <Grid>
        <Rectangle Height="232" HorizontalAlignment="Left" Margin="10,838,0,0" Name="Rectangle3" RadiusX="50" RadiusY="50" Stroke="Black" VerticalAlignment="Top" Width="1900" Opacity="0.9" StrokeThickness="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC2DBF0" Offset="0" />
                    <GradientStop Color="#FF3B83EC" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Height="88" HorizontalAlignment="Left" Margin="78,788,0,0" Name="Rectangle2" Stroke="White" VerticalAlignment="Top" Width="747" RadiusX="30" RadiusY="30" Opacity="1" StrokeThickness="3">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEA7D7D" Offset="0" />
                    <GradientStop Color="#FF531D1D" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock Text="Reference" Name="Reference" HorizontalAlignment="Left" VerticalAlignment="Top" Width="684" Foreground="White" FontSize="60" FontFamily="Century Gothic" Margin="115,796,0,0" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <Border BorderBrush="{x:Null}" Height="190" Margin="0,873,0,18" Width="1850">
            <TextBlock Text="Scripture" Name="Scripture" FontFamily="Century Gothic" FontSize="50" FontWeight="Bold" Width="1850" VerticalAlignment="Center" HorizontalAlignment="Left" MaxHeight="189" Foreground="Black" TextTrimming="WordEllipsis" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
